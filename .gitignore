
# Terraform working directory
terraform/.terraform/

# Terraform state and workspace state
terraform/*.tfstate*
terraform/terraform.tfstate.d/

# Terraform plans
terraform/*.tfplan
terraform/tfplan

# Local variable files and secrets
terraform/*.tfvars
terraform/*.tfvars.*

# Allow safe example configuration files
!terraform/dev.tfvars.example
!terraform/prod.tfvars.example

# Local backups
terraform/*.before-workspace-*

# Crash logs
crash.log
crash.*.log

# Node.js
node_modules/

# Environment files
.env
